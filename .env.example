# Copy this file to .env and fill in real values. Never commit .env.
#
# Variables here are named {SECTION}__{index}__{FIELD} - Azure App
# Configuration / ASP.NET Core-style hierarchical binding, where `index` is
# the connector's 0-based position within its kind's list in config.yaml
# (e.g. IRC__0__NICKSERV_PASSWORD, STOAT__1__TOKEN for the 2nd `stoat:`
# entry). No corresponding field needed in config.yaml - just set the var
# and it's picked up automatically; see config.py's module docstring for
# the full resolution rules (env var beats a literal value in config.yaml).
#
# To avoid keeping a secret in this plaintext file at all, set
# {SECTION}__{index}__{FIELD}_FILE instead, pointing at a file holding just
# the value - the Docker/Kubernetes secrets convention. See
# docker-compose.yml's commented `secrets:` example.
#
# Or give any value (here or in config.yaml) as a 1Password secret
# reference - `op://<vault>/<item>/<field>` - and it's resolved via the
# `op` CLI at startup, e.g. DISCORD__0__TOKEN=op://Bridge/discord/token.
# Requires an authenticated `op` (OP_SERVICE_ACCOUNT_TOKEN, or desktop-app
# integration); set OP_ACCOUNT to pass `op --account`. As with the other
# secrets, OP_SERVICE_ACCOUNT_TOKEN_FILE can point at a file holding the
# token instead (config.py loads it into OP_SERVICE_ACCOUNT_TOKEN at
# startup). The bridge's Docker image ships the `op` CLI by default (build
# with --build-arg INSTALL_OP=0 to omit it).
# OP_SERVICE_ACCOUNT_TOKEN=
# OP_SERVICE_ACCOUNT_TOKEN_FILE=
# OP_ACCOUNT=
#
# The commented-out names below match the current config.yaml.example.
# Uncomment/rename as needed for your actual deployment.

# Discord - one set per `discord:` entry in config.yaml
# DISCORD__0__GUILD_ID=
# DISCORD__0__TOKEN=

# Stoat - one set per `stoat:` entry in config.yaml
# STOAT__0__SERVER_ID=
# STOAT__0__API_URL=
# STOAT__0__TOKEN=
# STOAT__1__SERVER_ID=
# STOAT__1__API_URL=
# STOAT__1__TOKEN=

# IRC - one set per `irc:` entry in config.yaml (leave unset for no
# NickServ auth / no ident override / no auto-oper)
# IRC__0__NICK=
# IRC__0__NICKSERV_PASSWORD=
# IRC__0__IDENT=
# IRC__0__OPER_ACCOUNT=
# IRC__0__OPER_PASSWORD=

# MongoDB backend for channel-mapping and message-sync data (db_name isn't
# env-configurable - it's set directly in config.yaml's mongo.db_name)
MONGO__URI=mongodb://localhost:27017

# Port for the liveness HTTP endpoint Docker's HEALTHCHECK polls
# (GET /healthz) - see health_server.py. Not connector-specific, so it's a
# plain env var rather than a {SECTION}__{index}__{FIELD} one.
HEALTH_PORT=8080

# Log verbosity - DEBUG/INFO/WARNING/ERROR/CRITICAL (default INFO). DEBUG
# also lifts the log level of discord.py/aiohttp/websockets/irc, which are
# otherwise capped at WARNING to keep INFO output readable. See
# logging_setup.py.
# LOG_LEVEL=INFO

# Log redaction: bot tokens, the IRC NickServ/OPER passwords, and Mongo URI
# credentials are always scrubbed from log output (shown as ***), as are the
# passwords in raw IRC OPER/PASS/IDENTIFY lines. Set LOG_REDACT_IDS=1 to also
# redact raw platform ids (Discord snowflakes, Stoat ULIDs) - off by default
# because ids aren't credentials and redacting them hampers debugging. See
# logging_setup.py.
# LOG_REDACT_IDS=0
