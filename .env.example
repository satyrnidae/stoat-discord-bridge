# Copy this file to .env and fill in real values. Never commit .env.

# Discord bot token (from the Discord Developer Portal) + guild id
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Discord webhook URLs, one per bridged channel, used to post messages
# "as" the originating Stoat/IRC user (username + avatar override).
# DISCORD_WEBHOOK_URL_<channel-key>=https://discord.com/api/webhooks/...

# Stoat bot tokens + server ids
STOAT_PUBLIC_BOT_TOKEN=
STOAT_PUBLIC_SERVER_ID=
STOAT_SELFHOSTED_BOT_TOKEN=
STOAT_SELFHOSTED_SERVER_ID=

# IRC credentials (leave blank for no SASL/NickServ auth)
IRC_NICK=
IRC_NICKSERV_PASSWORD=

# MongoDB backend for channel-mapping and message-sync data
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=stoat_discord_bridge
