# Manager service for the stoat-discord-bridge docker compose stack (the
# bridge container plus its MongoDB). Modeled on the host's existing
# stoat-compose.service - a compose project needs `docker compose up -d`
# rather than the single-container `docker start -a <name>` pattern that
# shiny-raven.service / obstinate-spoonbill.service use.
#
# Install:
#   sudo cp units/stoat-discord-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now stoat-discord-bridge.service
#
# After changing code or the Dockerfile, rebuild before restarting:
#   docker compose -f /home/isabel/src/stoat-discord-bridge/docker-compose.yml build
#   sudo systemctl restart stoat-discord-bridge.service

[Unit]
Description=Start stoat-discord-bridge (Discord/Stoat/IRC chat bridge) via docker compose
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/isabel/src/stoat-discord-bridge
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop -t 10
ExecReload=/usr/bin/docker compose up -d

[Install]
WantedBy=multi-user.target
