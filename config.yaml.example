# Template for config.yaml - copy this file to config.yaml and fill in your
# actual deployment's ids/hosts. config.yaml itself is gitignored.
#
# Any field on any connector below can come from two places, in priority
# order (see the docstring at the top of src/stoat_discord_bridge/config.py
# for the full rules):
#
#   1. An env var named `{SECTION}__{index}__{FIELD}` - Azure App
#      Configuration / ASP.NET Core-style hierarchical binding, where
#      `index` is the connector's 0-based position within its kind's list
#      below (the first `stoat:` entry is index 0, the second is index 1,
#      etc). e.g. `DISCORD__0__TOKEN`, `STOAT__1__TOKEN`,
#      `IRC__0__NICKSERV_PASSWORD`.
#   2. A literal value written directly in config.yaml.
#
# Any value from either source may be a 1Password secret reference
# (`op://<vault>/<item>/<field>`), resolved via the `op` CLI at startup - so
# e.g. `bot_token: op://Bridge/discord/token` keeps the real secret out of
# this file. Opt-in: `op` is only invoked if an `op://` value is present.
#
# This example shows the *minimal* config.yaml this lets you get away with -
# only `id`/`label`/`host` (things you'd never really want to source from a
# secret store) are literal below; everything else (tokens, guild/server
# ids, IRC credentials) is expected to come from env vars named per rule 1
# above. You can just as easily go the other way and put everything literal
# in config.yaml instead, as long as you don't mind that shape being visible
# to anyone with access to this file on disk (recall config.yaml is
# gitignored either way, so it's never visible in the repo itself).

mongo:
  uri_env: MONGO__URI
  db_name: stoat_discord_bridge

discord:
  - id: discord
    label: Discord
    # guild_id, token: set DISCORD__0__GUILD_ID / DISCORD__0__TOKEN
    # Whether a /link-user'd sender is relayed as their linked local Discord
    # identity (nickname + avatar) rather than their remote one. Defaults to
    # true; set false (or DISCORD__0__ENABLE_LOCAL_USER_MASQUERADE=false) to
    # always show the remote identity instead, e.g. while diagnosing
    # local-user masquerade failures.
    enable_local_user_masquerade: true
    # Whether a message relayed *into* this Discord guild shows which
    # connector it originated on - the origin's `label` folded into the
    # webhook username as "name [Stoat (public)]". Defaults to true; set
    # false (or DISCORD__0__SOURCE_FORWARDING=false) to relay under the bare
    # name. (A source label that contains "discord" is masked by Discord's
    # own webhook-username rules.)
    source_forwarding: true
    # Whether a relayed inbound message shows the origin sender's pronouns as
    # "name [Stoat (public), she/her]" in the webhook name. Defaults to true;
    # set false (or DISCORD__0__PRONOUN_FORWARDING=false) to suppress it.
    # NOTE: Discord can't resolve its *own* users' pronouns - the profile
    # endpoint is blocked for bots (issue #58) - so this only affects inbound
    # display here, never what this connector forwards outward.
    pronoun_forwarding: true

stoat:
  - id: stoat_public
    label: Stoat (public)
    # server_id, api_url, token: set STOAT__0__SERVER_ID / STOAT__0__API_URL / STOAT__0__TOKEN
  - id: stoat_selfhosted
    label: Stoat (self-hosted)
    # server_id, api_url, token: set STOAT__1__SERVER_ID / STOAT__1__API_URL / STOAT__1__TOKEN
    # Whether a /link-user'd sender is relayed as their linked local Stoat
    # identity (masqueraded name + avatar) rather than their remote one.
    # Defaults to true; set false (or
    # STOAT__1__ENABLE_LOCAL_USER_MASQUERADE=false) to always show the
    # remote identity instead - useful here since local-user masquerade is
    # known to be flaky against some self-hosted Stoat instances.
    enable_local_user_masquerade: true
    # Whether a message relayed *into* this Stoat server shows which
    # connector it originated on - the origin's `label` folded into the
    # masquerade name as "name [Discord]" (truncated to Stoat's 32-char
    # masquerade-name limit if needed). Defaults to true; set false (or
    # STOAT__1__SOURCE_FORWARDING=false) to relay under the bare name.
    source_forwarding: true
    # Whether this connector resolves its own users' pronouns (from Stoat's
    # profile - this server's per-member value preferred over the account
    # one) and shows a relayed sender's pronouns as "name [Discord, she/her]".
    # Defaults to true; set false (or STOAT__1__PRONOUN_FORWARDING=false) to
    # skip the lookup. (stoat.py doesn't model a pronoun field, so this reads
    # the raw profile JSON - a no-op on a deployment that has no such field.)
    pronoun_forwarding: true
    # When a Discord thread is mirrored here (a channel under a Category
    # named after the thread's parent channel), also move that parent
    # channel into the Category, at the top - so the parent channel and all
    # its threads sit together. Defaults to true; set false (or
    # STOAT__1__GROUP_PARENT_CHANNEL_WITH_THREADS=false) to leave the parent
    # channel where it is. Re-checked on every relayed message.
    group_parent_channel_with_threads: true
    # Prefix the Stoat message-command parser triggers on. Defaults to "/"
    # (like Discord's slash commands); set e.g. "!" (or
    # STOAT__1__COMMAND_PREFIX=!) to avoid clashing with another bot or with
    # clients that swallow a leading "/". Command names are unchanged.
    command_prefix: "/"

irc:
  - id: irc
    label: IRC
    host: irc.example.net
    port: 6697
    use_tls: true
    # Applied (best-effort) to a channel only when the bridge's own JOIN is
    # what created it - see IrcSenderService.join_channel. If `P`
    # (InspIRCd permanent-channel) is among them it's split out and applied
    # separately, once the OPER handshake is confirmed (it's oper-only), and
    # is withheld entirely from ephemeral Discord-thread channels.
    default_channel_modes: "+HtnPR"
    # nick, nickserv_password: set IRC__0__NICK / IRC__0__NICKSERV_PASSWORD
    #
    # RFC1459 ident (the "user" field of the USER command) - optional, 1-9
    # characters, falls back to the nick if unset: IRC__0__IDENT
    #
    # /OPER login - deliberately a separate identity from `ident`/`nick`.
    # Leave both unset to skip auto-opering: IRC__0__OPER_ACCOUNT / IRC__0__OPER_PASSWORD
    #
    # Optional TLS client certificate for networks that authenticate the
    # connection itself (e.g. via a services cert-fp binding). Paths (not
    # secrets themselves) can go directly in config.yaml, or via
    # IRC__0__CLIENT_CERT_FILE / IRC__0__CLIENT_KEY_FILE if you'd rather
    # they vary per environment:
    client_cert_file: certs/irc-client.pem
    client_key_file: certs/irc-client.key
    #
    # Whether a /link-user'd sender is relayed under their linked local IRC
    # nick rather than their remote (Discord/Stoat) display name. Defaults
    # to true; set false (or IRC__0__ENABLE_LOCAL_USER_MASQUERADE=false) to
    # always show the remote identity instead.
    enable_local_user_masquerade: true
    #
    # Whether a message relayed *into* this IRC network shows which connector
    # it originated on - the origin's `label` added to the line's `<nick>`
    # tag as "<nick, Discord>". Defaults to true; set false (or
    # IRC__0__SOURCE_FORWARDING=false) to relay under the bare nick.
    source_forwarding: true
    #
    # IRC has no pronoun field of its own, so this only governs whether a
    # relayed inbound message shows the origin sender's pronouns in the
    # "<nick, Discord, she/her>" line tag. Defaults to true.
    pronoun_forwarding: true
